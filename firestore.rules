rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:  if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ── Drivers ───────────────────────────────────────────────────────────────
    // Lectura abierta a todos los autenticados (pasajeros ven conductores en mapa).
    // Escritura: el conductor escribe sus propios datos (registro, online/offline,
    //            actualizar perfil). El webhook (Admin SDK) también puede escribir.
    match /drivers/{driverId} {
      allow read:  if isAuth();
      allow write: if isOwner(driverId) || isAdmin();
    }

    // ── Trips ─────────────────────────────────────────────────────────────────
    // Lectura: solo el pasajero o conductor del viaje (o admin).
    // Creación: el pasajero crea el viaje y debe ser el propio uid.
    // Actualización: solo el conductor (cambia estado, posición, etc.) o admin.
    //   El Admin SDK (webhook) bypasea estas reglas.
    match /trips/{tripId} {
      allow read:   if isAuth() && (
        resource.data.passengerId == request.auth.uid ||
        resource.data.driverId   == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth() && request.resource.data.passengerId == request.auth.uid;
      allow update: if isAuth() && (
        // A. El pasajero del viaje puede cancelarlo o calificarlo
        (resource.data.passengerId == request.auth.uid) ||
        // B. El conductor asignado puede actualizar el estado
        (resource.data.driverId == request.auth.uid) ||
        // C. Un conductor libre puede aceptar un viaje sin conductor asignado
        (!('driverId' in resource.data) && request.resource.data.driverId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Payments ──────────────────────────────────────────────────────────────
    // Solo conductores registrados pueden crear su propio registro de pago.
    // Actualización/aprobación: solo webhook via Admin SDK (bypasea reglas).
    match /payments/{paymentId} {
      allow read:   if isAuth() && (
        resource.data.driverId == request.auth.uid || isAdmin()
      );
      allow create: if isAuth()
        && request.resource.data.driverId == request.auth.uid
        && exists(/databases/$(database)/documents/drivers/$(request.auth.uid));
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Subscriptions ─────────────────────────────────────────────────────────
    // Creadas/actualizadas SOLO por el webhook (Admin SDK).
    match /subscriptions/{subId} {
      allow read:  if isAuth() && (
        resource.data.driverId == request.auth.uid || isAdmin()
      );
      allow write: if isAdmin();
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:  if isAuth() && resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    // ── Admins ────────────────────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // ── Settings ──────────────────────────────────────────────────────────────
    match /settings/{doc} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Driver Identities (anti-fraude) ───────────────────────────────────────
    // Lectura: conductor autenticado la necesita para verificar duplicados al registrarse.
    // Escritura: conductor crea su propia identidad al registrarse (create).
    //            Solo admin puede actualizar o eliminar.
    match /driver_identities/{identityId} {
      allow get:    if isAuth(); // Verificar duplicado al registrarse
      allow list:   if isAdmin(); // Bloquea descarga masiva de datos personales
      allow create: if isAuth() && request.resource.data.driverId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
